# ─── Groq (gratis, sin tarjeta) ──────────────────────────────
# Obtén tu clave en: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Meta Graph API ──────────────────────────────────────────
# Page Access Token (no User Token) — generado desde Graph API Explorer
# Permisos requeridos: pages_manage_posts, pages_read_engagement, pages_show_list,
#                      business_management, instagram_basic, instagram_content_publish
META_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID de tu cuenta de Instagram Business
# Encuéntralo en: GET /{page-id}?fields=instagram_business_account con el Page Token
INSTAGRAM_BUSINESS_ACCOUNT_ID=1234567890

# ID de tu página de Facebook
# Encuéntralo en: Graph API Explorer → GET /{page-id}?fields=id,name
FACEBOOK_PAGE_ID=0987654321

# ─── Servidor ────────────────────────────────────────────────
PORT=3001

# URL pública del servidor — requerida para que Instagram descargue la imagen
# En desarrollo: usa ngrok → ngrok http 3001 → copia la URL https://xxxx.ngrok-free.app
# En producción: tu dominio real → https://tudominio.com
PUBLIC_URL=https://xxxx.ngrok-free.app
